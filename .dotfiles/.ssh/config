Match exec "test -f ~/.orbstack/ssh/config"
      Include ~/.orbstack/ssh/config

ServerAliveInterval 30

Host lavabutt.com
	Port 7433
	User ben

Host mulder.local mulder
	User ben

Host beast.local
	User ben

Host beastie.local
	User ben

Host banzai.local
	User ben

Host cavalier.local
	User ben

Host ubuntu.local ubuntu
	User ben

host ahab.local
	User root
	KexAlgorithms +diffie-hellman-group1-sha1
	
host newbuntu
	User ben
	Identityfile ~/.ssh/bak/id_ecdsa_sk

# GCP (project deal-tools).
#
# Reached over an IAP tunnel rather than the external IP: the IP is ephemeral
# and changes on every stop/start, so a HostName here would go stale. %h is the
# instance name, which is stable. Requires `gcloud auth login` and
# roles/iap.tunnelResourceAccessor; needs no inbound firewall rule beyond the
# IAP range 35.235.240.0/20.
#
# The key is per-machine and is NOT in this repo -- see .gitignore. Only the
# .pub is committed, as a record of which machines are authorized.
#
# NOTE for a new Mac: `gcloud compute ssh` registers the key under your LOCAL
# username (bf) in PROJECT metadata, but this block logs in as ben, whose keys
# live in carbonsteel's INSTANCE metadata. So a new machine's key must also be
# appended there, or auth fails with "Permission denied (publickey)" even
# though gcloud reported success:
#
#   gcloud compute instances describe carbonsteel --zone=us-central1-f \
#     --format="value(metadata.items.filter(key:ssh-keys).extract(value))" > keys
#   printf 'ben:%s\n' "$(cat ~/.ssh/google_compute_engine.pub)" >> keys
#   gcloud compute instances add-metadata carbonsteel --zone=us-central1-f \
#     --metadata-from-file ssh-keys=keys
#
# add-metadata REPLACES the whole ssh-keys value, so read-append-write is
# required; passing only the new key silently deletes every existing one.
Host carbonsteel
	HostName carbonsteel
	User ben
	IdentityFile ~/.ssh/google_compute_engine
	IdentitiesOnly yes
	# Passphrase once per boot, not once per connection: .zprofile runs
	# `keychain --eval`, whose agent outlives the shell, and this loads the key
	# into it on first use. Deliberately NOT UseKeychain -- that is an Apple ssh
	# patch, and $PATH here resolves ssh to Homebrew's upstream build, which
	# ignores it. It would also target the wrong agent.
	AddKeysToAgent yes
	ProxyCommand gcloud compute start-iap-tunnel %h 22 --listen-on-stdin --project=deal-tools --zone=us-central1-f --verbosity=warning
