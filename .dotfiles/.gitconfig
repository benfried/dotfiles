[color]
	ui = auto
	status = auto
	branch = auto
	interactive = auto
	diff = auto
[user]
	name = Ben Fried
	email = ben.fried@gmail.com
[alias]
	co = checkout
	ci = commit
	st = status
	br = branch
	hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
	type = cat-file -t
	dump = cat-file -p

# The trailing slash is load-bearing: git appends ** only to patterns that end
# in one, so "gitdir:/Users" matches a gitdir equal to /Users and nothing else,
# which no real repository ever is. Without it this include silently never
# fired. Check with `git config --get credential.helper` in a repo under
# /Users -- it should say osxkeychain.
[includeIf "gitdir:/Users/"]
	path = ~/.gitconfig-macos

[help]
	autocorrect = 1

#[merge]
#	tool = code

#[mergetool "code"]
#	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
[pull]
	rebase = false
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[init]
	defaultBranch = main
