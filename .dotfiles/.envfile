alias ech=echo
alias ech=true

ech "entering .envfile"
test -n "${-%%*i*}" && return 
test "$TERM" = xterm && trap 'eval $(resize -u)' WINCH
test -z "${KRBTKFILE:-}" && unset KRBTKFILE

set +o ignoreeof -h -a 
auto_resume=1
hostname_completion_file=/etc/hosts

alias noidle="while true; do echo -n 'what is the matrix? '; sleep 30; done"
alias da='date "+%a, %h %d, 19%y %r"'
# alias r="fc -s"
alias redo="r" 
alias source="." 
alias h="history"
alias blank="print -n \"`clear`\""
alias b="print -n \"`clear`\""
alias j="jobs -l"
alias z="kill -STOP $$"
alias cls=b
# -G means "colorize" to BSD ls but "omit the group column" to GNU ls, so it
# silently does the wrong thing on Linux. --color=auto is the GNU spelling.
if ls --color=auto -d . >/dev/null 2>&1; then
	alias ls="ls -F --color=auto"
else
	alias ls="ls -FG"
fi
alias h='fc -l'
alias yell=yellow
alias md=mkdir rd=rmdir
alias prot="chmod go-rwx"
alias im=ifmail
alias imr="im | egrep -v 'owner|rdist|web|www|notifyd'"
alias pd=pushd
alias root=su
alias n=note
alias u=users
umask 22
su()
{
	if [ "$#" = 0 ]; then
		PS1='${HOST%%.*};\W# ' /bin/su
	else
		PS1='${HOST%%.*};\u$ ' /bin/su $*
	fi
}
sudo()
{
	PS1="%U%B%m#%u%b " /usr/bin/sudo $*
}

term()
{
	if (test "$#" = 0 ); then
		echo $TERM
	else
		TERM=$1
		set -o noglob
		eval `tset -sQ $TERM`
		set +o noglob
		alias blank="print -n \"`clear`\""
		alias b="print -n \"`clear`\""

	fi
}

cln()
{
	if (test $# -eq 0); then
		rm -f *~* .*~* \#* >/dev/null
	else
		rm -f $1/*~* $1/.*~* $1/\#* >/dev/null
	fi
}

trsh()
{
	if (test $# -eq 0); then
		print *~* .*~* \#*
	else
		print $1/*~* $1/.*~* $1/\#*
	fi
}

# once from howie, now mostly mine.
ifmail()
{
	typeset i

	if [ "$#" -gt 1 ];
	then 
	   for i in $* 
	   do
		if test -s /usr/spool/mail/$i
		  then echo "$i: "; from $i
		  else echo "No new mail for $i."
		fi
	   done
	else 
	   if test -f /usr/spool/mail/$USER
#	     then mw -f
	     then from
	     else echo No New Mail.
  	   fi
	fi
}

c()
{
	fg %${1:-+}
}

setenv()
{
	eval "$1=\"$2\""; export $1
}

# quote the ksh builtins to defeat aliasing

whatis()
{
	'typeset' i_ foo_	# local variables
	'typeset' -i var
	for i_ in $*
	do
		var=0
		if 'set' | grep "^${i_}=" > /dev/null
		then
			'set' | grep "^${i_}="
			var=1
		fi
		foo_="`'whence' -v ${i_}`"

		case "$foo_" in
		*built-in*)	'print' - builtin ${i_}
				;;
		*function*)	'typeset' -f ${i_}
				;;
		*exported*)	'print' - "alias -x '${i_}=${foo_##*alias for }"
				;;
		*tracked*)	'print' - "alias -t '${i_}=${foo_##*alias for }'"
				;;
		*alias*)	'print' - "alias '${i_}=${foo_##*alias for }'"
				;;
		*not\ found)	if ((! var))
				then
					'print' - "$foo_"
				fi
				;;
		*)		'print' - "${foo_##*is }"
				;;
		esac
	done
	return 0
}

addplan()
{
	typeset i					# local vars
	typeset sep='--------'

	if let $#==0; then
		echo "$sep `da`" >> ~/.old-plans
		cat .plan >> ~/.old-plans
	else
		for i in $*
		do
			echo "$sep $i, `da`:" >> ~/.old-plans
			cat $i >> ~/.old-plans	# gross, I know
		done
	fi
}

idid()
{
	test ! -f ~/admin/.what-i-did && return;
	echo $WHO "-> `da`" >> ~/admin/.what-i-did
	echo "Type in what you did this session"
	cat >> ~/admin/.what-i-did
}

function status
 {
   laststatus=$?
   if [ $laststatus -gt 128 -a $laststatus -lt 160 ]; then
     echo "[Signal `expr $laststatus - 128`]"
   else
     echo "[Status $laststatus]"
   fi
   unset laststatus
 }

note()
{
	typeset nf=${NOTEFILE:-$HOME/etc/notes.txt}
	echo >> $nf
	da >>  $nf
	if let $#==0 ; then
		cat >> $nf
	else
		echo $@ >> $nf
	fi
}

# Remote desktop (XFCE) on carbonsteel, over an SSH tunnel.
#
#	vnc		bring the tunnel up if it is down, then open a viewer
#	vncdown		drop the tunnel
#
# There is nothing to start on the far end: tigervncserver@:1 is a systemd
# unit, enabled, so the session survives reboots and outlives every client.
# To poke at it there: sudo systemctl {status,restart,stop} tigervncserver@:1
#
# The server binds 127.0.0.1 only, so the forward is not an optimisation, it is
# the whole access path -- see Host carbonsteel-vnc in .ssh/config. A viewer
# warning about the connection being unencrypted is expected and safe to
# dismiss: SSH is carrying it, and nothing but sshd is exposed on that box.
#
# `ssh -f` rather than a trailing &, so that ssh forks only AFTER authenticating
# and any passphrase prompt still reaches the terminal. In practice keychain has
# the key cached, so this is silent except on the first connection after a boot.
vnc()
{
	# -O check queries the multiplexing master, which unlike `nc -z` says
	# whether OUR tunnel is alive rather than whether the port is occupied.
	if ssh -O check carbonsteel-vnc 2>/dev/null; then
		:
	else
		echo "vnc: bringing up tunnel..."
		ssh -f -N carbonsteel-vnc || return 1
	fi
	if [ "`uname -s`" = Darwin ]; then
		open vnc://localhost:5901		# Screen Sharing.app
	else
		vncviewer localhost:5901
	fi
}

# The tunnel is otherwise reaped by ControlPersist a few minutes after the last
# client goes away; this is only for when you want the port back now.
#
# Not vnc-down: this file is installed as $ENV (see .zprofile), so /bin/sh reads
# it too, and a hyphen in a function name is a parse error there -- one that
# takes the entire file down with it, not just the function.
vncdown()
{
	ssh -O exit carbonsteel-vnc 2>/dev/null
}

ERR=ERR
debug=0
test $debug -gt 0 && echo "$0 '${0%zsh}'"
test "${SHELL%zsh}" != "${SHELL}" && ERR=ZERR
#if [[ $TERM_PROGRAM != "WarpTerminal" ]]; then
#   test -z "${-%%*i*}" && trap 'status 1>&2' $ERR
#fi

ech "Leaving .envfile"
