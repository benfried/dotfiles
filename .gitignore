# Emacs runtime state & caches (not config — regenerated automatically)
.dotfiles/.emacs.d/.lsp-session-v1
.dotfiles/.emacs.d/recentf
.dotfiles/.emacs.d/org-clock-save.el
.dotfiles/.emacs.d/org-persist/
